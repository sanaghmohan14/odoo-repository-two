<templates xml:space="preserve">
    <t t-name='pos_sale.Orderline' t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//small[hasclass('attribute-line fst-italic')]" position="after">
            <span class="attribute-line fst-italic"  t-if="props.line.product_id.product_owner_id">
                product owner = <t t-esc="props.line.product_id.product_owner_id.name"/>
            </span>
            <div>
            </div>
        </xpath>
    </t>
</templates>

