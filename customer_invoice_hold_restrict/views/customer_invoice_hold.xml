<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_customer_invoice_hold_one" model="ir.actions.act_window">

        <field name="name">History</field>
        <field name="res_model">customer.invoice.hold</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="customer_invoice_hold_form" model="ir.ui.view">
        <field name="name">invoice hold form</field>
        <field name="model">customer.invoice.hold</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="invoice_hold"/>
                        <field name="hold_reason"/>
                        <field name="released_by"/>
                        <field name="released_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="customer_invoice_hold_Tree" model="ir.ui.view">
        <field name="name">invoice hold</field>
        <field name="model">customer.invoice.hold</field>
        <field name="arch" type="xml">
            <list>
                <field name="invoice_hold"/>
                <field name="hold_reason"/>
                <field name="released_by"/>
                <field name="released_date"/>
            </list>
        </field>
    </record>


</odoo>