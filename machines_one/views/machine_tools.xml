<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_machine_tools_one" model="ir.actions.act_window">

        <field name="name">Machine Tools</field>
        <field name="res_model">machine.tools</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="machine_tools_form" model="ir.ui.view">
        <field name="name">Machine Tools</field>
        <field name="model">machine.tools</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="machine_uses_id"/>
                        <field name="date"/>
                        <field name="amount"/>
                        <field name="paid"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="machine_tools_tree" model="ir.ui.view">
        <field name="name">Machine Tools Tree</field>
        <field name="model">machine.tools</field>
        <field name="arch" type="xml">
            <list>

                      <field name="machine_uses_id"/>
                        <field name="date"/>
                        <field name="amount"/>
                        <field name="paid"/>
            </list>
        </field>
    </record>
</odoo>