<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_machine_uses_one" model="ir.actions.act_window">

        <field name="name">Machine Uses</field>
        <field name="res_model">machine.uses</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="machine_uses_form" model="ir.ui.view">
        <field name="name">Machine Use</field>
        <field name="model">machine.uses</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable':'1'}" type="object"/>
<!--                     <button string="Approve Loan" type="object" name="action_approve_loan" invisible="state  in ['approved']"/>-->
<!--                    <button string="Generate Installments" type="object" name="action_create_installment" invisible="state  not in ['approved']"/>-->
                </header>
                <sheet>
                              <div name="button_box" class="oe_button_box">
                            <button class="oe_stat_button"
                                    type="object" icon="fa-wrench" name="action_view_machines" string="Tools">
                                <div class="o_stat_info">
                                    <field name="tools_count" string="Tools"/>
                                    <field name="machine_history" widget="statinfo" string="Machines Used"/>
                                </div>
                            </button>
                       </div>
                    <group>
                    <group>
                        <field name="name"/>
                        <field name="employee_id"/>
                        <field name="machine_name"/>
<!--                        <field name="installment_count"/>-->
<!--                        <field name="start_date"/>-->
                    </group>
                    <group>
                        <field name="machine_use"/>
                        <field name="start_date"/>
                        <field name="machine_amount"/>
                        <field name="installment_count"/>
                        <field name="installment_amount"/>
                        <field name="total_payable"/>
                    </group>
                    </group>

                        <notebook>
                        <page  string="Tools">
                            <field name="machine_tools_ids">
                                <list editable="bottom">
                                    <field name="machine_uses_id"/>
                                    <field name="date"/>
                                    <field name="amount"/>
                                    <field name="paid"/>
                                </list>

                            </field>
                        </page>
                    </notebook>


                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="machine_use_tree" model="ir.ui.view">
        <field name="name">Machine use Tree</field>
        <field name="model">machine.uses</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                       <field name="name"/>
                        <field name="employee_id"/>
                        <field name="machine_name"/>
                        <field name="start_date"/>
                        <field name="state"/>
            </list>
        </field>
    </record>
</odoo>