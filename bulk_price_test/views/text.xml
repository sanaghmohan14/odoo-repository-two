<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_vehicle_template">

        <t t-call="web.html_container">

            <t t-call="web.external_layout">

                <div class="page">

                    <h2 align="center">
                        Vehicle Repair Report
                    </h2>

                    <p>
                        <strong>Start Date :</strong>
                        <span t-esc="docs.start_date"/>
                    </p>

                    <p>
                        <strong>End Date :</strong>
                        <span t-esc="docs.end_date"/>
                    </p>

                    <table class="table table-bordered">

                        <thead>

                            <tr>

                                <th>Vehicle No</th>

                                <th>Customer</th>

                                <th>Advisor</th>

                                <th>Vehicle Model</th>

                                <th>Vehicle Type</th>

                                <th>Service Type</th>

                                <th>Start Date</th>

                                <th>End Date</th>

                                <th>Status</th>

                                <th>Estimated</th>

                                <th>Total</th>

                            </tr>

                        </thead>

                        <tbody>

                            <t t-foreach="records" t-as="rec">

                                <tr>

                                    <td>
                                        <span t-esc="rec['vehicle_no']"/>
                                    </td>

                                    <td>
                                        <span t-esc="rec['customer']"/>
                                    </td>

                                    <td>
                                        <span t-esc="rec['advisor']"/>
                                    </td>

                                    <td>
                                        <span t-esc="rec['vehicle_model']"/>
                                    </td>

                                    <td>
                                        <span t-esc="rec['vehicle_type']"/>
                                    </td>

                                    <td>
                                        <span t-esc="rec['service_type']"/>
                                    </td>

                                    <td>
                                        <span t-esc="rec['start_date']"/>
                                    </td>

                                    <td>
                                        <span t-esc="rec['end_date']"/>
                                    </td>

                                    <td>
                                        <span t-esc="rec['state']"/>
                                    </td>

                                    <td>
                                        <span t-esc="rec['estimated_amount']"/>
                                    </td>

                                    <td>
                                        <span t-esc="rec['total_amount']"/>
                                    </td>

                                </tr>

                            </t>

                        </tbody>

                    </table>

                </div>

            </t>

        </t>

    </template>

</odoo>