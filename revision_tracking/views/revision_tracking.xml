<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_revision_tracking_one" model="ir.actions.act_window">

        <field name="name">History</field>
        <field name="res_model">revision.tracking</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="revision_tracking_form" model="ir.ui.view">
        <field name="name">Revision Tracking</field>
        <field name="model">revision.tracking</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="modified_by"/>
                        <field name="modified_on"/>
                        <field name="revision_notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="revision_track_Tree" model="ir.ui.view">
        <field name="name">revision Track</field>
        <field name="model">revision.tracking</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="modified_by"/>
                <field name="modified_on"/>
                <field name="revision_notes"/>
            </list>
        </field>
    </record>


</odoo>