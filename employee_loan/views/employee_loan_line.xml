<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_employee_loan_line_one" model="ir.actions.act_window">

        <field name="name">Employee loan</field>
        <field name="res_model">employee.loan.line</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="employee_loan_service_form" model="ir.ui.view">
        <field name="name">Employee Loan</field>
        <field name="model">employee.loan.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="loan_id"/>
                        <field name="date"/>
                        <field name="amount"/>
                        <field name="paid"/>

                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="employee_loan_tree" model="ir.ui.view">
        <field name="name">Employee loan Tree</field>
        <field name="model">employee.loan.line</field>
        <field name="arch" type="xml">
            <list>

                      <field name="loan_id"/>
                        <field name="date"/>
                        <field name="amount"/>
                        <field name="paid"/>
            </list>
        </field>
    </record>
</odoo>