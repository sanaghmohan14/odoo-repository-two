<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="mrp_wizard" model="ir.ui.view">
        <field name="name">mrp</field>
        <field name="model">mrp.wizard</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button type="object" string="Submit" name="add_component"/>
                </header>
                <sheet>
                    <group>
                        <field name="order_id"/>
                    </group>
                        <field name="unavailable_component_ids" >
                            <list editable="bottom">
                                <field name="product_id" readonly="1"/>-->
                                <field name="product_uom_qty" readonly="1"/>
                                <field name="suggested_alternate_id" />
<!--                                domain="[('id','in',alternate_component_ids)]"-->
                            </list>

                        </field>

                </sheet>
            </form>
        </field>
    </record>

    <record id="create_mrp_wizard" model="ir.actions.act_window">
        <field name="name">mrp Wizard</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">mrp.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="mrp_wizard"/>
        <field name="target">new</field>
    </record>


</odoo>